generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  googleId  String   @unique
  email     String   @unique
  name      String
  avatarUrl   String?
  inviteToken String?  @unique
  createdAt   DateTime @default(now())

  flights             Flight[]
  cards               Card[]
  sentFriendships     Friendship[] @relation("Requester")
  receivedFriendships Friendship[] @relation("Addressee")
}

enum FlightStatus {
  SCHEDULED
  ACTIVE
  LANDED
  CANCELLED
  DIVERTED
  UNKNOWN
}

model Flight {
  id            String       @id @default(cuid())
  ownerId       String
  owner         User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  airlineIata   String
  flightNumber  String
  departureDate DateTime

  originIata    String
  destIata      String

  schedDep      DateTime?
  schedArr      DateTime?
  actualDep     DateTime?
  actualArr     DateTime?
  status        FlightStatus @default(SCHEDULED)
  gate          String?
  terminal      String?

  originTz      String?
  destTz        String?
  originCity    String?
  destCity      String?
  originLat     Float?
  originLon     Float?
  destLat       Float?
  destLon       Float?

  lastPolledAt  DateTime?
  shareToken    String?      @unique
  createdAt     DateTime     @default(now())

  cardFlights   CardFlight[]

  @@index([ownerId, departureDate])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  requester User @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
}

model Card {
  id         String   @id @default(cuid())
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title      String
  shareToken String   @unique @default(cuid())
  isPublic   Boolean  @default(false)
  createdAt  DateTime @default(now())

  cardFlights CardFlight[]
}

model CardFlight {
  cardId   String
  flightId String
  card     Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  flight   Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@id([cardId, flightId])
}

model Airport {
  iata      String  @id
  icao      String?
  name      String
  city      String?
  country   String?
  latitude  Float
  longitude Float
  tzName    String?
}
